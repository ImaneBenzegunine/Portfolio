# Local Docker URL. The proposed custom domain is NOT owned or connected.
SITE_URL=http://localhost:8088
# On Pages, set VITE_SITE_URL in its dashboard to the exact assigned HTTPS pages.dev URL.
# Leaving this blank lets the first Pages build use Cloudflare's CF_PAGES_URL.
VITE_SITE_URL=
PUBLIC_EMAIL=
HOST_PORT=8088
# Set true only after placing the real PDF at public/cv/Imane-Benzegunine-CV.pdf.
CV_AVAILABLE=false
# local stores test inquiries on this machine; it DOES NOT send email.
CONTACT_MODE=local
PUBLIC_ORIGIN=http://localhost:8088
RETENTION_DAYS=7
# Generate with: docker compose run --rm --no-deps backend node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=local-only-change-before-publishing
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
