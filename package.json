{
  "name": "imane-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write src backend/*.mjs backend/test cloudflare functions scripts/*.mjs tests *.ts *.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir .render && node scripts/prerender.mjs",
    "typecheck": "tsc -b && tsc -p tsconfig.cloudflare.json",
    "lint": "eslint .",
    "test": "node --test backend/test/*.test.mjs && npm run test:cloudflare",
    "test:cloudflare": "node --experimental-strip-types --test cloudflare/test/*.test.ts",
    "test:pages": "node scripts/test-pages.mjs",
    "test:pages:browser": "node scripts/test-pages.mjs --browser",
    "pages:dev": "wrangler pages dev dist --port 8788 --d1 CONTACT_DB=00000000-0000-0000-0000-000000000000 --persist-to .wrangler/state --compatibility-date 2026-09-27",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.0",
    "@fontsource/dm-serif-display": "^5.2.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.58.2",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "miniflare": "^5.20260926.1-alpha",
    "prettier": "^3.9.9",
    "sharp": "^0.35.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "wrangler": "^4.144.0"
  }
}
