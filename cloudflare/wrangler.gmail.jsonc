{
  "name": "portfolio-contact-delivery",
  "main": "gmail-worker.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "vars": {
    "DELIVERY_ENABLED": "true",
    "DELIVERY_PROVIDER": "gmail",
    "MAIL_FROM": "benzegunineimane@gmail.com",
    "MAIL_TO": "benzegunineimane@gmail.com"
  },
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "portfolio-contact",
      "database_id": "bcc55b23-a7a7-4e92-ae55-539395b6e224",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
